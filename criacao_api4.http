@host = http://localhost:8080
@hostLocal = http://localhost:5223
@apiKey = scott
@bandId1 = 1
@bandId2 = 2
@cdId1 = 1
@cdId2 = 2

### BANDS - CREATE (1)
POST {{host}}/bands
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "name": "Linkin Park",
  "description": "Alternative rock band."
}

###

### BANDS - CREATE (2)
POST {{host}}/bands
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "name": "Metallica",
  "description": "Heavy metal band."
}

###

### BANDS - GET ALL (DEFAULT PAGINATION)
GET {{host}}/bands
Accept: application/json
X-API-KEY: {{apiKey}}

###

### BANDS - GET ALL (PAGINATION pageSize=1)
GET {{host}}/bands?pageNumber=1&pageSize=1
Accept: application/json
X-API-KEY: {{apiKey}}

###

### BANDS - GET ALL (PAGINATION pageNumber=2 pageSize=1)
GET {{host}}/bands?pageNumber=2&pageSize=1
Accept: application/json
X-API-KEY: {{apiKey}}

###

### BANDS - GET ALL (PAGINATION pageSize=100 -> max 25)
GET {{host}}/bands?pageNumber=1&pageSize=100
Accept: application/json
X-API-KEY: {{apiKey}}

###

### BANDS - GET BY ID (EXISTING)
GET {{host}}/bands/{{bandId1}}
Accept: application/json
X-API-KEY: {{apiKey}}

###

### BANDS - UPDATE (EXISTING)
PUT {{host}}/bands/{{bandId1}}
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "name": "Linkin Park (Updated)",
  "description": "Updated band description."
}

###

### CDS - CREATE (1)
POST {{host}}/cds
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "name": "Hybrid Theory",
  "bandId": {{bandId1}},
  "rating": 5
}

###

### CDS - CREATE (2)
POST {{host}}/cds
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "name": "Meteora",
  "bandId": {{bandId1}},
  "rating": 5
}

###

### CDS - GET ALL (DEFAULT PAGINATION)
GET {{host}}/cds
Accept: application/json
X-API-KEY: {{apiKey}}

###

### CDS - GET ALL (PAGINATION pageSize=1)
GET {{host}}/cds?pageNumber=1&pageSize=1
Accept: application/json
X-API-KEY: {{apiKey}}

###

### CDS - GET BY ID (EXISTING)
GET {{host}}/cds/{{cdId1}}
Accept: application/json
X-API-KEY: {{apiKey}}

###

### CDS - GET BY BAND (DEFAULT PAGINATION)
GET {{host}}/cds/band/{{bandId1}}
Accept: application/json
X-API-KEY: {{apiKey}}

###

### CDS - GET BY BAND (PAGINATION pageSize=1)
GET {{host}}/cds/band/{{bandId1}}?pageNumber=1&pageSize=1
Accept: application/json
X-API-KEY: {{apiKey}}

###

### CDS - SEARCH BY NAME
GET {{host}}/cds/search?name=mete&pageNumber=1&pageSize=25
Accept: application/json
X-API-KEY: {{apiKey}}

###

### CDS - UPDATE (EXISTING)
PUT {{host}}/cds/{{cdId1}}
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "name": "Hybrid Theory (Remastered)",
  "bandId": {{bandId1}},
  "rating": 4
}

###

### BANDS - GET WITH CDS
GET {{host}}/bands/with-cds/{{bandId1}}
Accept: application/json
X-API-KEY: {{apiKey}}

###

### MUSICBRAINZ - GET RELEASES (PAGINATION)
GET {{host}}/releases/expedita?pageNumber=1&pageSize=10
Accept: application/json
X-API-KEY: {{apiKey}}

###

### CDS - DELETE (EXISTING)
DELETE {{host}}/cds/{{cdId2}}
X-API-KEY: {{apiKey}}

###

### BANDS - DELETE (EXISTING)
DELETE {{host}}/bands/{{bandId2}}
X-API-KEY: {{apiKey}}

###
